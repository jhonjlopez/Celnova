<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrincipal"
    android:orientation="vertical"
    tools:context=".activities.VendedorPerfilActivity">

    <!-- HEADER ESTÁTICO -->
    <LinearLayout
        android:id="@+id/linearLayoutVendedorPerfilHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundPrincipal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/linearLayoutVendedorPerfilLogoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgVendedorPerfilLogo"
                android:layout_width="85dp"
                android:layout_height="26dp"
                android:src="@drawable/brand_logo" />

            <TextView
                android:id="@+id/txtVendedorPerfilHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Perfil"
                android:textColor="@color/txtTitulo"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorPerfilBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#D1FAE5"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/txtVendedorPerfilBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="✓ Verificado"
                    android:textColor="#065F46"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <View
            android:id="@+id/viewVendedorPerfilHeaderSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/linearLayoutVendedorPerfilIconos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgVendedorPerfilIconoNotificacion"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/icono_notificacion"
                app:tint="@color/iconPrincipal" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorPerfilAvatarHeader"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/backgroundCard"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgVendedorPerfilAvatarHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:src="@drawable/icono_usuario"
                    app:tint="@color/iconPrincipal" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

    <!-- BODY SCROLLVIEW -->
    <ScrollView
        android:id="@+id/scrollViewVendedorPerfil"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/linearLayoutVendedorPerfilRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- PROFILE STORE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorPerfilStoreCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/backgroundSecundario"
                app:cardCornerRadius="20dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="0.7dp">

                <LinearLayout
                    android:id="@+id/linearLayoutVendedorPerfilStoreCardInterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorPerfilStoreTop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardVendedorPerfilStoreAvatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:cardBackgroundColor="@color/bannerFondo"
                            app:cardCornerRadius="32dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/imgVendedorPerfilStoreAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="14dp"
                                android:src="@drawable/icono_tienda"
                                app:tint="#FFFFFF" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorPerfilStoreInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorPerfilStoreNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="TechStore Colombia"
                                android:textColor="@color/txtTitulo"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorPerfilPropietario"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Jhon Jairo López Amias • Vendedor Oficial"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtVendedorPerfilStoreId"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="ID: CN-COL-89218 • Miembro desde Oct 2023"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="11sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STATS ROW (3 KPI CARDS) -->
            <LinearLayout
                android:id="@+id/linearLayoutVendedorPerfilStatsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <!-- Stat 1: Ventas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorPerfilStat1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorPerfilStat1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/imgVendedorPerfilStat1Icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/icono_ventas"
                            app:tint="@color/txtTituloSecundario" />

                        <TextView
                            android:id="@+id/txtVendedorPerfilStat1Val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="$148.2M"
                            android:textColor="@color/txtTitulo"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtVendedorPerfilStat1Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ventas Totales"
                            android:textColor="@color/txtTextoSecundario"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stat 2: Reputación -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorPerfilStat2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorPerfilStat2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/imgVendedorPerfilStat2Icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/icono_favorito_lleno"
                            app:tint="#F59E0B" />

                        <TextView
                            android:id="@+id/txtVendedorPerfilStat2Val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="4.9 ★"
                            android:textColor="@color/txtTitulo"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtVendedorPerfilStat2Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="342 Reseñas"
                            android:textColor="@color/txtTextoSecundario"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stat 3: Envíos -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorPerfilStat3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorPerfilStat3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/imgVendedorPerfilStat3Icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/icono_check_verificado"
                            app:tint="#059669" />

                        <TextView
                            android:id="@+id/txtVendedorPerfilStat3Val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="98.7%"
                            android:textColor="@color/txtTitulo"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtVendedorPerfilStat3Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cumplimiento"
                            android:textColor="@color/txtTextoSecundario"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- INFORMACIÓN DE LA EMPRESA SECTION -->
            <LinearLayout
                android:id="@+id/linearLayoutVendedorPerfilEmpresaSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtVendedorPerfilEmpresaHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PERFIL PROFESIONAL &amp; EMPRESA"
                    android:textColor="@color/txtTextoSecundario"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Item 1: Razón Social & NIT -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorPerfilItemNit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorPerfilItemNit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorPerfilNitIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_tienda"
                            app:tint="@color/txtTituloSecundario" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorPerfilNitInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorPerfilNitTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Razón Social &amp; NIT"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorPerfilNitSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="TechStore Colombia SAS • NIT 901.442.310-3"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgVendedorPerfilNitArrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 2: Certificación CRC -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorPerfilItemCrc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorPerfilItemCrc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorPerfilCrcIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_check_verificado"
                            app:tint="#059669" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorPerfilCrcInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorPerfilCrcTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Homologación CRC"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorPerfilCrcSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Estado: Homologado y Verificado 2024"
                                android:textColor="#059669"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgVendedorPerfilCrcArrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 3: Datos de Contacto Vendedor -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorPerfilItemContacto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorPerfilItemContacto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorPerfilContactoIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_email"
                            app:tint="@color/txtTituloSecundario" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorPerfilContactoInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorPerfilContactoTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Datos de Contacto"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorPerfilContactoSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="jhonjlopezvendedor@gmail.com • +57 312 680 4421"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgVendedorPerfilContactoArrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 4: Cuenta Bancaria de Retiro -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorPerfilItemBanco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorPerfilItemBanco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorPerfilBancoIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_puntos"
                            app:tint="@color/txtTituloSecundario" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorPerfilBancoInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorPerfilBancoTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cuenta Bancaria de Retiros"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorPerfilBancoSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Bancolombia Ahorros •••• 8821 (PSE Activo)"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgVendedorPerfilBancoArrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 5: Soporte al Vendedor 24/7 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorPerfilItemSoporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorPerfilItemSoporte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorPerfilSoporteIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_soporte"
                            app:tint="@color/txtTituloSecundario" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorPerfilSoporteInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorPerfilSoporteTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Soporte a Vendedores 24/7"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorPerfilSoporteSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Atención preferencial para tiendas oficiales"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgVendedorPerfilSoporteArrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- LOGOUT BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVendedorPerfilCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#FEE2E2"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Cerrar Sesión Vendedor"
                android:textColor="#DC2626"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="25dp"
                app:elevation="0dp"
                app:icon="@drawable/icono_cerrar_sesion"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="#DC2626" />

        </LinearLayout>

    </ScrollView>

    <!-- VENDEDOR BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationVendedorPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundSecundario"
        app:elevation="8dp"
        app:itemIconTint="@color/navColorIconos"
        app:itemTextColor="@color/navColorIconos"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/vendedor_bottom_nav_menu" />

</LinearLayout>
