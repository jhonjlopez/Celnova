<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrincipal"
    android:orientation="vertical"
    tools:context=".activities.CarritoActivity">

    <LinearLayout
        android:id="@+id/linearLayoutCarritoHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/imgCarritoLogo"
            android:layout_width="110dp"
            android:layout_height="32dp"
            android:src="@drawable/brand_logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/imgCarritoIconoNotificacion"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/icono_notificacion"
            app:tint="@color/iconPrincipal" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/circleImgCarritoIconoPerfil"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/icono_usuario"
            app:civ_border_color="@color/lineaDivisor"
            app:civ_border_width="1dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollViewCarrito"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/linearLayoutCarritoRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/txtCarritoTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="Mi carrito"
                android:textColor="@color/txtTitulo"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCarritoSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Revisa los productos que elegiste"
                android:textColor="@color/txtTextoSecundario"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/linearLayoutCarritoItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCarritoItemsVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="34dp"
                    android:text="Tu carrito está vacío. Explora el catálogo y agrega tus productos favoritos."
                    android:textColor="@color/txtTextoSecundario"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutCarritoCuponSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCarritoCuponTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cupón de descuento"
                    android:textColor="@color/txtTitulo"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCarritoCuponAplicado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#D1FAE5"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/icono_codigo_descuento"
                            app:tint="#065F46" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtCarritoCuponCodigo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="oferton10"
                                android:textColor="#065F46"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtCarritoCuponDescuento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="10% de descuento aplicado"
                                android:textColor="#047857"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgCarritoCuponClose"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:src="@drawable/icono_error"
                            app:tint="#065F46" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/backgroundSecundario"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0.2dp"
                        app:strokeColor="@color/lineaDivisor"
                        app:strokeWidth="0.7dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/icono_codigo_descuento"
                                app:tint="@color/iconSecundario" />

                            <EditText
                                android:id="@+id/etCarritoCupon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:background="@null"
                                android:hint="Código promocional"
                                android:inputType="text"
                                android:textColor="@color/inputTexto"
                                android:textColorHint="@color/inputHint"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCarritoAplicarCupon"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:backgroundTint="@color/btnPrincipal"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="20dp"
                        android:text="Aplicar"
                        android:textColor="@color/btnPrincipalTexto"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:elevation="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCarritoCuponMensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/estadoError"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCarritoResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/backgroundSecundario"
                app:cardCornerRadius="16dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="0.7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Resumen de compra"
                        android:textColor="@color/txtTitulo"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subtotal"
                            android:textColor="@color/txtTexto"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtCarritoSubtotalValor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$ 0 COP"
                            android:textColor="@color/txtTitulo"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linearLayoutCarritoDescuento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Descuento (cupón)"
                            android:textColor="@color/estadoExito"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtCarritoDescuentoValor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="- $ 0 COP"
                            android:textColor="@color/estadoExito"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Envío estimado"
                            android:textColor="@color/txtTexto"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtCarritoEnvioResumenValor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gratis"
                            android:textColor="@color/estadoExito"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Impuestos incluidos (IVA 19%)"
                            android:textColor="@color/txtTexto"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtCarritoImpuestosValor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$ 0 COP"
                            android:textColor="@color/txtTitulo"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/lineaDivisor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total a pagar"
                            android:textColor="@color/txtTitulo"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCarritoAhorroValor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:text=""
                            android:textColor="@color/estadoExito"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCarritoTotalValorResumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$ 0 COP"
                            android:textColor="@color/txtTitulo"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/linearLayoutCarritoAcciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundSecundario"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total a pagar"
                android:textColor="@color/txtTitulo"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtCarritoTotalValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 0 COP"
                android:textColor="@color/txtTitulo"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCarritoPagar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/btnPrincipal"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Pagar"
            android:textColor="@color/btnPrincipalTexto"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="25dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCarritoSeguirComprando"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Seguir comprando"
            android:textColor="@color/btnPrincipal"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="25dp"
            app:strokeColor="@color/btnPrincipal"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationCarrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundSecundario"
        app:elevation="8dp"
        app:itemIconTint="@color/navColorIconos"
        app:itemTextColor="@color/navColorIconos"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
