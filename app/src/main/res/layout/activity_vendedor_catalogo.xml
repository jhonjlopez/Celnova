<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrincipal"
    android:orientation="vertical"
    tools:context=".activities.VendedorCatalogoActivity">

    <LinearLayout
        android:id="@+id/linearLayoutVendedorCatalogoHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundPrincipal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/linearLayoutVendedorCatalogoLogoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgVendedorCatalogoLogo"
                android:layout_width="85dp"
                android:layout_height="26dp"
                android:src="@drawable/brand_logo" />

            <TextView
                android:id="@+id/txtVendedorCatalogoHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Catálogo"
                android:textColor="@color/txtTitulo"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorCatalogoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#D1FAE5"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/txtVendedorCatalogoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="✓"
                    android:textColor="#065F46"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <View
            android:id="@+id/viewVendedorCatalogoHeaderSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/linearLayoutVendedorCatalogoIconos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgVendedorCatalogoIconoNotificacion"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/icono_notificacion"
                app:tint="@color/iconPrincipal" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorCatalogoPerfilContainer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/backgroundCard"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgVendedorCatalogoIconoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:src="@drawable/icono_usuario"
                    app:tint="@color/iconPrincipal" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollViewVendedorCatalogo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/linearLayoutVendedorCatalogoRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/linearLayoutVendedorCatalogoTitleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/linearLayoutVendedorCatalogoTitleTexts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtVendedorCatalogoTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mi Catálogo"
                        android:textColor="@color/txtTitulo"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVendedorCatalogoSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="38 productos activos • Bodega Bogotá"
                        android:textColor="@color/txtTextoSecundario"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorCatalogoOnlineBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#D1FAE5"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/txtVendedorCatalogoOnline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="● En línea"
                        android:textColor="#065F46"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorCatalogoBusqueda"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/backgroundCard"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/linearLayoutVendedorCatalogoBusquedaInterno"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/imgVendedorCatalogoIconoBusqueda"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/icono_busqueda"
                        app:tint="@color/iconSecundario" />

                    <EditText
                        android:id="@+id/etVendedorCatalogoBuscar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Buscar por SKU, nombre o marca..."
                        android:inputType="text"
                        android:textColor="@color/inputTexto"
                        android:textColorHint="@color/inputHint"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/imgVendedorCatalogoIconoMic"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:scaleType="centerInside"
                        android:src="@drawable/icono_microphone"
                        app:tint="@color/iconSecundario" />

                    <ImageView
                        android:id="@+id/imgVendedorCatalogoIconoFiltro"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:scaleType="centerInside"
                        android:src="@drawable/icono_ajuste"
                        app:tint="@color/iconSecundario" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <HorizontalScrollView
                android:id="@+id/horizontalScrollVendedorCatalogoChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/linearLayoutVendedorCatalogoChipsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardVendedorCatalogoChipTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="#D1FAE5"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/txtVendedorCatalogoChipTodos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="Todos 38"
                            android:textColor="#065F46"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardVendedorCatalogoChipStock"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/backgroundCard"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/txtVendedorCatalogoChipStock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="Con Stock 34"
                            android:textColor="@color/txtTitulo"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardVendedorCatalogoChipBajo"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        app:cardBackgroundColor="#FEF3C7"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/txtVendedorCatalogoChipBajo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="⚠ Stock Bajo 4"
                            android:textColor="#B45309"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorCatalogoBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/bannerFondo"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/linearLayoutVendedorCatalogoBannerInterno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <FrameLayout
                        android:id="@+id/frameVendedorCatalogoBannerIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="#003440"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/imgVendedorCatalogoBannerIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/icono_camara"
                            app:tint="@color/txtBannerPrincipal" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorCatalogoBannerTexts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtVendedorCatalogoBannerTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Alta Rápida de Inventario"
                            android:textColor="@color/txtBannerPrincipal"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtVendedorCatalogoBannerSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Toma foto, asigna precio COP"
                            android:textColor="#A5F3FC"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVendedorCatalogoCrear"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#FEF3C7"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="+ Crear"
                        android:textColor="#B45309"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:elevation="0dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorProd1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/backgroundSecundario"
                app:cardCornerRadius="16dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="0.7dp">

                <LinearLayout
                    android:id="@+id/linearLayoutVendedorProd1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorProd1Top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/frameVendedorProd1Image"
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <ImageView
                                android:id="@+id/imgVendedorProd1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/icono_laptop" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardVendedorProd1Badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|start"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="#B45309"
                                app:cardCornerRadius="4dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:id="@+id/txtVendedorProd1Badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="1dp"
                                    android:text="-15% PROMO"
                                    android:textColor="#FFFFFF"
                                    android:textSize="8sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorProd1Info"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorProd1Titulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Xiaomi Redmi Note 13 Pro+ 5G (512GB)"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorProd1Sku"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="SKU: CEL-XIA-13P"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:id="@+id/linearLayoutVendedorProd1PriceRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtVendedorProd1Precio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$1.699.000 COP"
                                    android:textColor="@color/txtTituloSecundario"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtVendedorProd1PrecioOld"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="$1.999.000"
                                    android:textColor="@color/txtTextoSecundario"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/txtVendedorProd1Stock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="📦 14 unidades disponibles"
                                android:textColor="@color/estadoExito"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchVendedorProd1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorProd1Footer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVendedorProd1Editar"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="@color/backgroundCard"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="14dp"
                            android:text="Editar"
                            android:textColor="@color/btnPrincipal"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:elevation="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVendedorProd1Promo"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:backgroundTint="#FEF3C7"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="14dp"
                            android:text="Crear Promo"
                            android:textColor="#B45309"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:elevation="0dp" />

                        <ImageView
                            android:id="@+id/imgVendedorProd1Delete"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/icono_eliminar"
                            app:tint="#DC2626" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorProd2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/backgroundSecundario"
                app:cardCornerRadius="16dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="0.7dp">

                <LinearLayout
                    android:id="@+id/linearLayoutVendedorProd2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorProd2Top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/frameVendedorProd2Image"
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <ImageView
                                android:id="@+id/imgVendedorProd2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/icono_audifono" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardVendedorProd2Badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|start"
                                android:layout_margin="4dp"
                                app:cardBackgroundColor="#D97706"
                                app:cardCornerRadius="4dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:id="@+id/txtVendedorProd2Badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="1dp"
                                    android:text="!Stock Bajo"
                                    android:textColor="#FFFFFF"
                                    android:textSize="8sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.card.MaterialCardView>
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorProd2Info"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorProd2Titulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Audífonos Sony WH-1000XM5 Noise..."
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorProd2Sku"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="SKU: AUD-SNY-M5"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/txtVendedorProd2Precio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="$1.349.000 COP"
                                android:textColor="@color/txtTituloSecundario"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorProd2Stock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
