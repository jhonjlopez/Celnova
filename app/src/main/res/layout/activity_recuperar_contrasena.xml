<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.RecuperarContrasenaActivity">

    <ScrollView
        android:id="@+id/scrollViewRecuperarContrasena"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/linearLayoutRecuperarContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <LinearLayout
                android:id="@+id/linearLayoutRecuperarContrasenaHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/linearLayoutRecuperarContrasenaAtrasIconoTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:id="@+id/imgRecuperarContrasenaIconoAtras"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/icono_atras"
                        app:tint="@color/iconPrincipal">
                    </ImageView>
                    <TextView
                        android:id="@+id/txtRecuperarContrasenaAtras"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atras"
                        android:textColor="@color/iconPrincipal"
                        android:layout_gravity="center_vertical"
                        android:textSize="18sp">
                    </TextView>
                </LinearLayout>

                <View
                    android:id="@+id/viewRecuperarContrasenaHeader"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1">
                </View>

                <ImageView
                    android:id="@+id/imgRecuperarContrasenaLogo"
                    android:layout_width="110dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/brand_logo">
                </ImageView>
            </LinearLayout>

            <ImageView
                android:id="@+id/imgRecuperarContrasenaIcono"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:src="@drawable/icono_recuperar_contrasena"
                app:tint="@color/iconPrincipal">

            </ImageView>

            <TextView
                android:id="@+id/txtRecuperarContrasenaTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¿Olvidaste tu contraseña?"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/txtTitulo"
                android:gravity="center_horizontal"
                android:layout_marginTop="24dp">
            </TextView>

            <TextView
                android:id="@+id/txtRecuperarContrasenaSubtituloInstrucciones"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:text="Ingresa tus datos registrados para recibir un enlace seguro."
                android:textSize="15sp"
                android:textColor="@color/txtTexto"
                android:gravity="center_horizontal"
                android:layout_marginTop="16dp">
            </TextView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRecuperarContrasenaCorreoySms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/backgroundCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/linearLayoutRecuperarContrasenaCorreoySms"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:padding="5dp"
                    android:weightSum="2">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRecuperarContrasenaCorreo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="false"
                        app:cardBackgroundColor="@color/backgroundCardSecundario"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:id="@+id/linearLayoutRecuperarContrasenaCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:id="@+id/imgRecuperarContrasenaCorreoIcono"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/icono_email"
                                app:tint="@color/brandSecondario">
                            </ImageView>

                            <TextView
                                android:id="@+id/txtRecuperarContrasenaCorreo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Correo"
                                android:textColor="@color/txtTitulo"
                                android:textSize="16sp">
                            </TextView>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRecuperarContrasenaSms"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="false"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:id="@+id/linearLayoutRecuperarContrasenaSms"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:id="@+id/imgRecuperarContrasenaSmsIcono"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/icono_telefono"
                                app:tint="@color/iconSecundario">
                            </ImageView>

                            <TextView
                                android:id="@+id/txtRecuperarContrasenaSms"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="SMS (+57)"
                                android:textColor="@color/txtTexto"
                                android:textSize="16sp">
                            </TextView>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/linearLayoutRecuperarContrasenaCorreoRegistrado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="top">

                <TextView
                    android:id="@+id/txtRecuperarLabelCorreo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo electrónico registrado"
                    android:textColor="@color/txtTitulo"
                    android:textSize="16sp">
                </TextView>

                <ImageView
                    android:id="@+id/imgRecuperarContrasenaCorreoAsterisco"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/icono_asterisco"
                    app:tint="@color/estadoError">
                </ImageView>
            </LinearLayout>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/etCardRecuperarContrasenaCorreo"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/inputFondo"
                app:cardCornerRadius="12dp"
                app:cardElevation="0.2dp"
                app:strokeColor="@color/inputBorde"
                app:strokeWidth="0.7dp">

                <LinearLayout
                    android:id="@+id/etlinearLayoutRecuperarContrasenaCorreoRegistrado"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/imgRecuperarContrasenaCorreoIconoRegistrado"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/icono_email"
                        app:tint="@color/iconSecundario">
                    </ImageView>

                    <View
                        android:id="@+id/viewRecuperarContrasenaCorreoRegistrado"
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@color/lineaDivisor">
                    </View>

                    <EditText
                        android:id="@+id/etRecuperarContrasenaCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:hint="ejemplo@gmail.com"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/inputTexto"
                        android:textColorHint="@color/inputHint"
                        android:textSize="16sp"
                        android:maxLength="254">
                    </EditText>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtRecuperarContrasenaInstrucciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minLines="2"
                android:gravity="center"
                android:text="Te llegará un enlace de seguridad para restablecer la contraseña."
                android:textColor="@color/txtTextoSecundario"
                android:textSize="13sp">
            </TextView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecuperarContrasenaRestablecer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/btnPrincipal"
                android:text="Restablecer"
                android:textColor="@color/btnPrincipalTexto"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                app:cornerRadius="25dp">
            </com.google.android.material.button.MaterialButton>

            <LinearLayout
                android:id="@+id/linearLayoutRecuperarContrasenaIniciaSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtRecuperarContrasenaPregunta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Recordaste tu contraseña?"
                    android:textSize="16sp"
                    android:textColor="@color/txtTexto">
                </TextView>

                <TextView
                    android:id="@+id/txtRecuperarContrasenaIniciaSesion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Inicia sesión"
                    android:textColor="@color/txtTituloSecundario"
                    android:textSize="18sp"
                    android:textStyle="bold">
                </TextView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutRecuperarContrasenaCifrado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgRecuperarContrasenaCifradoIcono"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icono_cifrado"
                    app:tint="@color/iconSecundario">
                </ImageView>

                <TextView
                    android:id="@+id/txtRecuperarContrasenaCifrado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Tus datos están protegidos con cifrado"
                    android:textColor="@color/txtTextoSecundario"
                    android:textSize="14sp">
                </TextView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
