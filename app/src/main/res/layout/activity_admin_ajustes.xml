<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrincipal"
    android:orientation="vertical"
    tools:context=".activities.AdminAjustesActivity">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/linearLayoutAdminAjustesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundPrincipal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/linearLayoutAdminAjustesLogoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgAdminAjustesLogo"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:src="@drawable/brand_logo" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminAjustesBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/btnPrincipal"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/txtAdminAjustesBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Ajustes"
                    android:textColor="@color/btnPrincipalTexto"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <View
            android:id="@+id/viewAdminAjustesHeaderSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/linearLayoutAdminAjustesIconos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgAdminAjustesIconoNotificacion"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/icono_notificacion"
                app:tint="@color/iconPrincipal" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminAjustesIconoPerfilContainer"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/backgroundCard"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgAdminAjustesIconoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:src="@drawable/icono_usuario"
                    app:tint="@color/iconPrincipal" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollViewAdminAjustes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/linearLayoutAdminAjustesRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/txtAdminAjustesTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ajustes"
                android:textColor="@color/txtTitulo"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAdminAjustesSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Configuración general de la plataforma CELNOVA"
                android:textColor="@color/txtTextoSecundario"
                android:textSize="11sp" />

            <!-- CUENTA -->
            <TextView
                android:id="@+id/txtAdminAjustesCuentaLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="CUENTA"
                android:textColor="@color/txtTextoSecundario"
                android:textSize="10sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminAjustesCuenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/backgroundCard"
                app:cardCornerRadius="14dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="0.7dp">

                <LinearLayout
                    android:id="@+id/linearLayoutAdminAjustesCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Seguridad -->
                    <LinearLayout
                        android:id="@+id/rowAdminAjustesSeguridad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/frameAdminAjustesSeguridadIconContainer"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="#E0F2FE"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgAdminAjustesSeguridadIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/icono_candado"
                                app:tint="#0369A1" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/linearLayoutAdminAjustesSeguridadInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtAdminAjustesSeguridadTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Seguridad y acceso"
                                android:textColor="@color/txtTitulo"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtAdminAjustesSeguridadSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Contraseña y autenticación"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgAdminAjustesSeguridadChevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />
                    </LinearLayout>

                    <View
                        android:id="@+id/viewAdminAjustesDivisor2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="58dp"
                        android:background="@color/lineaDivisor" />

                    <!-- Notificaciones -->
                    <LinearLayout
                        android:id="@+id/rowAdminAjustesNotificaciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/frameAdminAjustesNotificacionesIconContainer"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="#FEF3C7"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgAdminAjustesNotificacionesIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/icono_notificacion"
                                app:tint="#B45309" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/linearLayoutAdminAjustesNotificacionesInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtAdminAjustesNotificacionesTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Notificaciones"
                                android:textColor="@color/txtTitulo"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtAdminAjustesNotificacionesSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Alertas de pedidos y stock"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAdminAjustesNotificaciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PLATAFORMA -->
            <TextView
                android:id="@+id/txtAdminAjustesPlataformaLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="PLATAFORMA"
                android:textColor="@color/txtTextoSecundario"
                android:textSize="10sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminAjustesPlataforma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/backgroundCard"
                app:cardCornerRadius="14dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="0.7dp">

                <LinearLayout
                    android:id="@+id/linearLayoutAdminAjustesPlataforma"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowAdminAjustesTienda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/frameAdminAjustesTiendaIconContainer"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="#EAF6F2"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgAdminAjustesTiendaIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/icono_tienda"
                                app:tint="@color/txtTituloSecundario" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/linearLayoutAdminAjustesTiendaInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtAdminAjustesTiendaTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Preferencias de la tienda"
                                android:textColor="@color/txtTitulo"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtAdminAjustesTiendaSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Idioma, moneda y región"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgAdminAjustesTiendaChevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />
                    </LinearLayout>

                    <View
                        android:id="@+id/viewAdminAjustesDivisor3"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="58dp"
                        android:background="@color/lineaDivisor" />

                    <LinearLayout
                        android:id="@+id/rowAdminAjustesPagos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/frameAdminAjustesPagosIconContainer"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="#E0F2FE"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgAdminAjustesPagosIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/icono_cifrado"
                                app:tint="#0369A1" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/linearLayoutAdminAjustesPagosInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtAdminAjustesPagosTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Métodos de pago"
                                android:textColor="@color/txtTitulo"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtAdminAjustesPagosSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Pasarelas y conciliación"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgAdminAjustesPagosChevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />
                    </LinearLayout>

                    <View
                        android:id="@+id/viewAdminAjustesDivisor4"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="58dp"
                        android:background="@color/lineaDivisor" />

                    <LinearLayout
                        android:id="@+id/rowAdminAjustesFacturacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/frameAdminAjustesFacturacionIconContainer"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="#FEF3C7"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgAdminAjustesFacturacionIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/icono_pedidos"
                                app:tint="#B45309" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/linearLayoutAdminAjustesFacturacionInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtAdminAjustesFacturacionTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Impuestos y facturación"
                                android:textColor="@color/txtTitulo"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtAdminAjustesFacturacionSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="DIAN, retenciones y XML"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgAdminAjustesFacturacionChevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SOPORTE -->
            <TextView
                android:id="@+id/txtAdminAjustesSoporteLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SOPORTE"
                android:textColor="@color/txtTextoSecundario"
                android:textSize="10sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdminAjustesSoporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/backgroundCard"
                app:cardCornerRadius="14dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="0.7dp">

                <LinearLayout
                    android:id="@+id/linearLayoutAdminAjustesSoporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowAdminAjustesAyuda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/frameAdminAjustesAyudaIconContainer"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="#EAF6F2"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgAdminAjustesAyudaIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/icono_soporte"
                                app:tint="@color/txtTituloSecundario" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/linearLayoutAdminAjustesAyudaInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtAdminAjustesAyudaTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Centro de ayuda"
                                android:textColor="@color/txtTitulo"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtAdminAjustesAyudaSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Preguntas frecuentes y soporte"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgAdminAjustesAyudaChevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />
                    </LinearLayout>

                    <View
                        android:id="@+id/viewAdminAjustesDivisor5"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="58dp"
                        android:background="@color/lineaDivisor" />

                    <LinearLayout
                        android:id="@+id/rowAdminAjustesAcerca"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:id="@+id/frameAdminAjustesAcercaIconContainer"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="#E0F2FE"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgAdminAjustesAcercaIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/icono_puntos"
                                app:tint="#0369A1" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/linearLayoutAdminAjustesAcercaInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtAdminAjustesAcercaTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Acerca de CELNOVA"
                                android:textColor="@color/txtTitulo"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtAdminAjustesAcercaSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Versión y términos legales"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgAdminAjustesAcercaChevron"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtAdminAjustesVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="CELNOVA Admin · v1.0.0"
                android:textColor="@color/txtTextoSecundario"
                android:textSize="10sp" />

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationAdminAjustes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundSecundario"
        app:elevation="8dp"
        app:itemIconTint="@color/navColorIconos"
        app:itemTextColor="@color/navColorIconos"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/admin_bottom_nav_menu" />

</LinearLayout>
