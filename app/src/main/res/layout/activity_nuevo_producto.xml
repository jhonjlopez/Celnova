<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrincipal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="60dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/imgNuevoProductoAtras"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/icono_atras"
        app:tint="@color/iconPrincipal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nuevo Producto"
        android:textColor="@color/txtTitulo"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Foto del producto"
                android:textColor="@color/txtTitulo"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgNuevoProductoFoto"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginBottom="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/icono_tienda" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNuevoProductoTomarFoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/backgroundCard"
                        android:text="📸 Tomar foto"
                        android:textColor="@color/btnPrincipal"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnNuevoProductoGaleria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/backgroundCard"
                        android:text="🖼️ Galería"
                        android:textColor="@color/btnPrincipal"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etNuevoProductoNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_campo"
                    android:hint="Nombre del producto"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/inputTexto"
                    android:textColorHint="@color/inputHint"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etNuevoProductoDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_campo"
                    android:gravity="top"
                    android:hint="Descripción"
                    android:padding="16dp"
                    android:textColor="@color/inputTexto"
                    android:textColorHint="@color/inputHint"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etNuevoProductoPrecio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_campo"
                        android:hint="Precio (COP)"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:textColor="@color/inputTexto"
                        android:textColorHint="@color/inputHint"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etNuevoProductoStock"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_campo"
                        android:hint="Stock"
                        android:inputType="number"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="14dp"
                        android:textColor="@color/inputTexto"
                        android:textColorHint="@color/inputHint"
                        android:textSize="14sp" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/spnNuevoProductoCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_campo" />

                <Button
                    android:id="@+id/btnNuevoProductoGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/btnPrincipal"
                    android:text="Guardar producto"
                    android:textColor="@color/btnPrincipalTexto"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="25dp"
                    app:elevation="2dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
