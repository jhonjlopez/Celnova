<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrincipal"
    android:orientation="vertical"
    tools:context=".activities.VendedorAjustesActivity">

    <!-- HEADER ESTÁTICO -->
    <LinearLayout
        android:id="@+id/linearLayoutVendedorAjustesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundPrincipal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/linearLayoutVendedorAjustesLogoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgVendedorAjustesLogo"
                android:layout_width="85dp"
                android:layout_height="26dp"
                android:src="@drawable/brand_logo" />

            <TextView
                android:id="@+id/txtVendedorAjustesHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ajustes"
                android:textColor="@color/txtTitulo"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorAjustesBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#D1FAE5"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/txtVendedorAjustesBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="✓"
                    android:textColor="#065F46"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <View
            android:id="@+id/viewVendedorAjustesHeaderSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/linearLayoutVendedorAjustesIconos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgVendedorAjustesIconoNotificacion"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/icono_notificacion"
                app:tint="@color/iconPrincipal" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVendedorAjustesAvatarHeader"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/backgroundCard"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lineaDivisor"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/imgVendedorAjustesAvatarHeader"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:src="@drawable/icono_usuario"
                    app:tint="@color/iconPrincipal" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

    <!-- BODY SCROLLVIEW -->
    <ScrollView
        android:id="@+id/scrollViewVendedorAjustes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/linearLayoutVendedorAjustesRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- TITLE & SUBTITLE -->
            <LinearLayout
                android:id="@+id/linearLayoutVendedorAjustesTitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtVendedorAjustesTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configuración de la Tienda"
                    android:textColor="@color/txtTitulo"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtVendedorAjustesSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ajustes de ventas, comisiones, notificaciones y pasarelas"
                    android:textColor="@color/txtTextoSecundario"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- SECTION 1: OPERACIÓN DE LA TIENDA -->
            <LinearLayout
                android:id="@+id/linearLayoutVendedorAjustesOperacionSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtVendedorAjustesOperacionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OPERACIÓN DE LA TIENDA"
                    android:textColor="@color/txtTextoSecundario"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Item 1: Estado de la tienda -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorAjustesEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorAjustesEstado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorAjustesEstadoIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_tienda"
                            app:tint="@color/txtTituloSecundario" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorAjustesEstadoInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorAjustesEstadoTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Tienda Abierta al Público"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorAjustesEstadoSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Recibiendo pedidos e interacciones en vivo"
                                android:textColor="#059669"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchVendedorAjustesTiendaAbierta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 2: Modo Vacaciones -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorAjustesVacaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorAjustesVacaciones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorAjustesVacacionesIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_pedidos"
                            app:tint="@color/txtTituloSecundario" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorAjustesVacacionesInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorAjustesVacacionesTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Modo Vacaciones"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorAjustesVacacionesSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Pausar publicaciones y recepción de compras"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchVendedorAjustesVacaciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- SECTION 2: NOTIFICACIONES Y ALERTAS -->
            <LinearLayout
                android:id="@+id/linearLayoutVendedorAjustesNotifSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtVendedorAjustesNotifHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NOTIFICACIONES Y ALERTAS"
                    android:textColor="@color/txtTextoSecundario"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Item 1: Alertas de Ventas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorAjustesNotifVentas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorAjustesNotifVentas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorAjustesNotifVentasIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_notificacion"
                            app:tint="@color/txtTituloSecundario" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorAjustesNotifVentasInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorAjustesNotifVentasTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Alertas de Nuevas Ventas"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorAjustesNotifVentasSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Notificación push e email al vender un producto"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchVendedorAjustesNotifVentas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 2: Alertas de Stock Crítico -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorAjustesNotifStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorAjustesNotifStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorAjustesNotifStockIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_error"
                            app:tint="#B45309" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorAjustesNotifStockInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorAjustesNotifStockTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Alertas de Stock Crítico"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorAjustesNotifStockSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Aviso inmediato cuando un SKU tenga &lt; 3 unidades"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchVendedorAjustesNotifStock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- SECTION 3: PAGOS Y SEGURIDAD -->
            <LinearLayout
                android:id="@+id/linearLayoutVendedorAjustesSeguridadSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtVendedorAjustesSeguridadHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PAGOS &amp; SEGURIDAD"
                    android:textColor="@color/txtTextoSecundario"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Item 1: Biometría para Retiros -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorAjustesBiometria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorAjustesBiometria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorAjustesBiometriaIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_huella"
                            app:tint="@color/txtTituloSecundario" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorAjustesBiometriaInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorAjustesBiometriaTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Confirmación Biométrica de Retiros"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorAjustesBiometriaSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Requerir huella dactilar para procesar retiros PSE"
                                android:textColor="@color/txtTextoSecundario"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchVendedorAjustesBiometria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Item 2: Facturación DIAN -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVendedorAjustesDian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/backgroundSecundario"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/lineaDivisor"
                    app:strokeWidth="0.7dp">

                    <LinearLayout
                        android:id="@+id/linearLayoutVendedorAjustesDian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/imgVendedorAjustesDianIcon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/icono_cifrado"
                            app:tint="@color/txtTituloSecundario" />

                        <LinearLayout
                            android:id="@+id/linearLayoutVendedorAjustesDianInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtVendedorAjustesDianTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Facturación Electrónica DIAN"
                                android:textColor="@color/txtTitulo"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtVendedorAjustesDianSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Firma digital activa • Rango habilitado Serie FE"
                                android:textColor="#059669"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgVendedorAjustesDianArrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:rotation="180"
                            android:src="@drawable/icono_atras"
                            app:tint="@color/iconSecundario" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- VENDEDOR BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationVendedorAjustes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/backgroundSecundario"
        app:elevation="8dp"
        app:itemIconTint="@color/navColorIconos"
        app:itemTextColor="@color/navColorIconos"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/vendedor_bottom_nav_menu" />

</LinearLayout>
